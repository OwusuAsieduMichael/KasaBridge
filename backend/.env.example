PORT=3001
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/kasabridge

# Optional: require SSL for managed Postgres (e.g. Neon, RDS)
# PGSSLMODE=require
# PG_REJECT_UNAUTHORIZED=false

OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# CORS: * or comma-separated origins (e.g. http://localhost:5173)
CORS_ORIGIN=*
